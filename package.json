{
  "name": "stamp-generator",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint \"packages/**/*.{ts,tsx}\"",
    "test": "npm run test --workspaces --if-present && vitest run",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "sharp": "0.35.3",
    "jsdom": "^29.1.1"
  }
}
